rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is an authorized admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection: Read restricted to the matching admin, writes fully disabled
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Products Collection: Public may read published items, writes require admin credentials
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Wishlist Subcollection: Users isolated to their matching Firebase UID
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shortlist Subcollection: Users isolated to their matching Firebase UID
    match /users/{userId}/shortlist/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Enquiries Collection: Anyone may submit, but reads and updates require admin
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'mobile', 'categoryOrProduct', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string 
        && request.resource.data.mobile.size() >= 8 
        && request.resource.data.mobile.size() <= 15
        && request.resource.data.categoryOrProduct is string 
        && request.resource.data.categoryOrProduct.size() <= 200
        && request.resource.data.message is string 
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is string;

      allow read, update, delete: if isAdmin();
    }

    // Rates Collection: Public may read active rates, writes require admin credentials
    match /rates/{rateId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }
  }
}
