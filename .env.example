# Public Site Base URL (used for canonical URLs, sitemap, Open Graph, and WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://khushi-ornament-house.vercel.app

# Firebase Client Configuration (Public Web SDK Configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=khushi-ornament-house.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=khushi-ornament-house
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=khushi-ornament-house.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
