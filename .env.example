# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web App Configuration
# Copy these values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# SECURITY & DEPLOYMENT GUIDANCE:
# - NEXT_PUBLIC_* values are client-visible configuration embedded into the browser bundle at build time.
# - Adding or changing these variables in hosting environments (e.g. Vercel Production & Preview) must be done BEFORE the build.
# - Updating these values requires a fresh deployment / rebuild to take effect in production or preview.
# - Service-account keys, private keys, admin credentials, access tokens, and server secrets must NEVER be placed in NEXT_PUBLIC_* variables or committed.

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
